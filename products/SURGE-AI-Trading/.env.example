# ============================================================
# SURGE-AI Trading - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env to version control!
# ============================================================

# ============================================================
# APPLICATION SETTINGS
# ============================================================

# Debug mode (set to false in production)
DEBUG=false

# ============================================================
# BINANCE API (Required for trading)
# ============================================================
# Get your API keys from: https://www.binance.com/en/my/settings/api-management
# For testnet: https://testnet.binance.vision/

# API Key and Secret (leave empty for price streaming only)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Use testnet for testing (true = testnet, false = mainnet)
BINANCE_TESTNET=true

# ============================================================
# TRADING CONFIGURATION
# ============================================================

# Trading pair (e.g., BTCUSDT, ETHUSDT)
TRADING_SYMBOL=BTCUSDT

# Enable live trading (DANGEROUS - set to true only when ready)
TRADING_ENABLED=false

# Signal threshold (0.5 = neutral, higher = more confident signals needed)
SIGNAL_THRESHOLD=0.55

# ============================================================
# RISK MANAGEMENT
# ============================================================

# Maximum position size per trade (% of total capital)
MAX_POSITION_SIZE_PERCENT=12.5

# Maximum total exposure (% of total capital)
MAX_TOTAL_EXPOSURE_PERCENT=50.0

# Maximum drawdown before kill switch triggers (%)
MAX_DRAWDOWN_PERCENT=15.0

# Daily loss limit (%)
DAILY_LOSS_LIMIT_PERCENT=3.0

# Minimum confidence threshold for signals (%)
MIN_CONFIDENCE_THRESHOLD=70.0

# ============================================================
# DATABASE CONFIGURATION
# ============================================================

# TimescaleDB
POSTGRES_USER=postgres
POSTGRES_PASSWORD=surge_secret_2024
POSTGRES_DB=surge_trading
TIMESCALE_PORT=5432

# Redis
REDIS_PORT=6379

# Milvus
MILVUS_PORT=19530
MILVUS_GRPC_PORT=9091

# MinIO (Milvus storage)
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# ============================================================
# SERVICE PORTS
# ============================================================

# Backend API
BACKEND_PORT=8000

# Frontend Dashboard
FRONTEND_PORT=3000

# Admin Tools (optional)
ATTU_PORT=8080
PGADMIN_PORT=8081
NGINX_PORT=80

# pgAdmin credentials
PGADMIN_EMAIL=admin@suriota.com
PGADMIN_PASSWORD=admin123

# ============================================================
# FRONTEND CONFIGURATION
# ============================================================

# WebSocket URL for frontend (change if behind proxy)
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws

# API URL for frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Currency conversion
DEFAULT_IDR_RATE=16000

# ============================================================
# EXTERNAL APIs (Optional)
# ============================================================

# CryptoPanic API (for sentiment analysis)
# Get free API key: https://cryptopanic.com/developers/api/
CRYPTOPANIC_API_KEY=

# Santiment API (for on-chain data)
# Get free API key: https://santiment.net/
SANTIMENT_API_KEY=

# LunarCrush API (for social sentiment)
# Get free API key: https://lunarcrush.com/developers/api
LUNARCRUSH_API_KEY=

# ============================================================
# ADVANCED SETTINGS
# ============================================================

# Grafana (if using monitoring stack)
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin123
