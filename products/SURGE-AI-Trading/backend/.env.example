# ============================================================
# SURGE-AI Trading Dashboard - Backend Environment Variables
# ============================================================
# Copy this file to .env and fill in your values

# Application
DEBUG=true

# Binance API (optional - for live trading)
# Leave empty for public data only (price streaming)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# Trading Configuration
TRADING_SYMBOL=BTCUSDT
TRADING_ENABLED=false

# Risk Management
MAX_POSITION_SIZE_PERCENT=12.5
MAX_TOTAL_EXPOSURE_PERCENT=50.0
MAX_DRAWDOWN_PERCENT=15.0
DAILY_LOSS_LIMIT_PERCENT=3.0
MIN_CONFIDENCE_THRESHOLD=70.0

# Currency Conversion
DEFAULT_IDR_RATE=16000

# Redis (optional - for caching)
REDIS_URL=
